# ===== 数据库（cms-db 容器）=====
POSTGRES_DB=qtycms
POSTGRES_USER=qtycms
POSTGRES_PASSWORD=请改为强随机密码

# ===== 后端 cms-backend =====
# 镜像仓库前缀（留空则使用本地构建的镜像）；例如 registry.cn-hangzhou.aliyuncs.com/yourns
REGISTRY=
TAG=latest

# JWT 密钥：至少 32 字节的随机串（生产务必替换）
CMS_JWT_SECRET=请改为至少32字节的强随机字符串
CMS_JWT_EXPIRATION_MINUTES=120

# 首次启动创建的种子超管（登录后强制改密）
CMS_ADMIN_USER=admin
CMS_ADMIN_PASS=请改为强密码
CMS_ADMIN_FORCE_CHANGE=true

# 允许访问控制台 API 的来源（控制台域名），多个用逗号分隔
CMS_CORS_ORIGINS=http://localhost

# 发布后触发公开站重建的钩子（二选一）
#   Vercel Deploy Hook：直接填该 URL
#   GitHub Actions workflow_dispatch：
#     https://api.github.com/repos/<owner>/<repo>/actions/workflows/deploy.yml/dispatches
DEPLOY_HOOK_URL=
# 部署令牌：仅用于拉取已发布内容（/api/content/published）与 GitHub 钩子鉴权
CMS_DEPLOY_TOKEN=请改为随机令牌

# ===== 控制台 cms-console（nginx）=====
CONSOLE_PORT=80
